{
  "name": "@usefluid/motion",
  "version": "0.1.2",
  "description": "Exact springs and Metamorph contour morphing for any logo. No dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./theme.css": "./theme.css"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "animation",
    "spring",
    "morph",
    "svg",
    "react",
    "motion",
    "logo"
  ],
  "homepage": "https://fluidui.willradoux.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useFluid/fluidui.git",
    "directory": "packages/motion"
  },
  "bugs": {
    "url": "https://github.com/useFluid/fluidui/issues"
  }
}